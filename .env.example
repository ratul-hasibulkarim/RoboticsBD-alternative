# Copy to .env and fill in. Every secret is read from the environment and validated at boot.
ENV=dev
SECRET_KEY=dev-only-secret-change-me-0123456789abcdef
# sha256 hex of each admin bearer token, comma separated:  printf '%s' "$TOKEN" | sha256sum
ADMIN_TOKEN_SHA256=
TYPESENSE_API_KEY=voltfind-dev-key
EMBEDDING_BACKEND=hashing
# LLM extraction (stage B) — empty disables it. Ollama: http://ollama:11434
LLM_BASE_URL=
LLM_MODEL=llama3.1:8b
LLM_DAILY_BUDGET_USD=5
# Official APIs — clients refuse to run until the source is approved in crawler/sources.yaml AND a key is set.
MOUSER_API_KEY=
DIGIKEY_CLIENT_ID=
DIGIKEY_CLIENT_SECRET=
YOUTUBE_API_KEY=
GITHUB_TOKEN=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
WEB_REVALIDATE_SECRET=dev-revalidate-secret
PUBLIC_SITE_URL=http://localhost:3000
